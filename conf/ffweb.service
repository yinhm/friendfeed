[Unit]
Description=FriendFeed web server
After=network-online.target ffdb.service
Wants=network-online.target
Requires=ffdb.service

[Service]
Type=simple
User=%(runner_user)s
Group=%(runner_group)s
WorkingDirectory=%(project_path)s
ExecStart=%(go_path)s/bin/ffweb -p 8080 -s=%(salt)s -c=%(config_file)s
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ffweb
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
