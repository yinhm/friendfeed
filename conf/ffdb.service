[Unit]
Description=FriendFeed database and API server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=%(runner_user)s
Group=%(runner_group)s
WorkingDirectory=%(project_path)s
ExecStart=%(go_path)s/bin/ffdb -c %(project_path)s/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ffdb
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target
